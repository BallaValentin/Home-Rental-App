<h1>Beszélgetéseim</h1>

{{#each discussions}}
    {{#if (eq kuldoID you.felhID) }}
    <div class = 'user-discussion-message'>
        <div class="message-box-name">You --- {{them.nev}}</div>
        {{szoveg}}
        <div class="message-box-date">{{kuldesiIdo}}</div>
        <br>
        <a href="/show_discussion?user1ID={{you.felhID}}&user2ID={{them.felhID}}">Részletek</a>
    </div>
    {{else}}
    <div class = 'user-discussion-message'>
        <div class="message-box-name">{{them.nev}} --- You</div>
        {{szoveg}}
        <div class="message-box-date">{{kuldesiIdo}}</div>
        <br>
        <a href="/show_discussion?user1ID={{you.felhID}}&user2ID={{them.felhID}}">Részletek</a>
    </div>
    {{/if}}
{{/each}}
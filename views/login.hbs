<div id="login-user-background">
    <form action="/login-user" id="login-user-form" method="post">
        <div class="login-form-field">
            <label for="username">Username:</label>
            <input class="my-input" type="text" name="username"><br>
        </div>
        <div class="login-form-field">
            <label for="password">Password:</label></label>
            <input class="my-input" type="password" name="password"><br>
        </div>
        <button type="submit">Log In</button>
        <div class="registration-text">Don`t have an account yet?</div>
        <a class="registration-link" href="/registration">Sign up here!</a>
        <p class="ok-message">{{ok_message}}</p>
        <p class="error-message">{{err_message}}</p>
    </form>
</div>
<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <script src="client.js"></script>
    <title>Lakáshirdetések</title>
</head>
<body>
    <header>
        Lakáshirdetések
        <div id="options-container">
            <div id="image-uploader-button">
                <a href="./index-pictures.html">Kép feltöltése</a>
            </div>
            <div id="advertisement-uploader-button">
                <a href="./index.html">Lakáshirdetés feltöltése</a>
            </div>
        </div>
    </header>
    <form action="/advertisement_search" id="advertisement_search_form" method="get">
        <div id="search-attribute-container">
            <div class="advertisement-search-attribute">
            <label class="label-form" for="city_name">Város neve: </label>
            <input class="my-input" type="text" name="city_name">
            </div>
            <div class="advertisement-search-attribute">
            <label class="label-form" for="city_quarter_name">Negyede: </label>
            <input class="my-input" type="text" name="city_quarter_name">
            </div>
            <div class="advertisement-search-attribute">
            <label class="label-form" for="min_price">Minimum ár: </label>
            <input class="my-input" type="text" name="min_price">
            </div>
            <div class="advertisement-search-attribute">
            <label class="label-form" for="max_price">Maximum ár: </label>
            <input class="my-input" type="text" name="max_price">
            </div>
            <button id="search-button" type="submit">Keresés</button>
        </div>
    </form>
    <div id="panel-container">
        <div id="menu-panel">
            <form action="/submit_advertisement_upload" id="advertisement-uploader-form" method="post">
                <p class="p-form">Város:</p>
                <input class="my-input" type="text" name="city"><br>
                <p class="p-form">Városnegyed:</p>
                <input class="my-input" type="text" name="city_quarter"><br>
                <p class="p-form">Felszinterület:</p>
                <input class="my-input" type="text" name="surface_area"><br>
                <p class="p-form">Ár:</p>
                <input class="my-input" type="text" name="price"><br>
                <p class="p-form">Szobák száma:</p>
                <input class="my-input" type="text" name="number_of_rooms"><br><br>
                <label class="label-form" for="upload_date">Feltöltés dátuma:</label>
                <input class="my-input" type="date" name="upload_date"><br><br>
                <button class="my-submit" type="submit">Lakáshirdetés feltöltése</button>
            </form>
        </div>
        <div id="advertisement-panel">
            Itt lesznek a lakáshirdetések
        </div>
    </div>
    <div id="felhasznalok" name="felhasznalok">
          {{#each felhasznalok}}
            <p>{{this.nev}}</p>
          {{/each}}
    </div>
</body>
</html>
<div id="login-user-background">
    <form action="/login-user" id="login-user-form" method="post">
        <div class="login-form-field">
            <label for="username">Felhasználónév:</label>
            <input class="my-input" type="text" name="username"><br>
        </div>
        <div class="login-form-field">
            <label for="password">Jelszó:</label></label>
            <input class="my-input" type="password" name="password"><br>
        </div>
        <button type="submit">Bejelentkezés</button>
    </form>
    <p class="error-message">{{message}}</p>
</div>
<h1>{{advertisement.varosnev}} - {{advertisement.negyednev}}</h1>
<p class="advertisement-info">Ár: {{advertisement.ar}}</p>
<p class="advertisement-info">Szobák száma: {{advertisement.szobakSzama}}</p>
<p class="advertisement-info">Felszín terület: {{advertisement.felszTerulet}}</p>
<p class="advertisement-info">Feltöltés dátuma: {{advertisement.feltDatum}}</p>

{{#if canEditAdvertisement}}
  <h2>Fényképek feltöltése</h2>
  <form action="/upload_picture" id="picture_uploader_form", method="post" enctype="multipart/form-data">
    <input type="file" name="picture">
    <input type="hidden" name="advertisementID" value={{advertisement.hirdetesID}}>
    <button class="my-submit" type="submit">Feltöltés</button>
  </form>
{{/if}}

<h2>Fényképek</h2>
{{#if pictures.length}}
    <div class="images-container">
    {{#each pictures}}
      <div id="image-container-{{kepID}}" class="image-container">
      <img src="{{elUtvonal}}" alt="Fénykép">
      {{#if ../canEditAdvertisement}}
        <button onclick="deletePicture('{{kepID}}')">Törlés</button>
      {{/if}}
    </div>
    {{/each}}
    </div>
{{else}}
  <div class="image-placeholder">Nincsenek fényképek.</div>
{{/if}}

{{#if canSendMessage}}
  <a href="/show_discussion?user1ID={{userID}}&user2ID={{owner.felhID}}">[Üzenet küldése {{owner.nev}}-nek]</a>
{{/if}}
<p class="error-message">{{message}}</p>
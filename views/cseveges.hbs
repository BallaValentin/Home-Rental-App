<h1>{{them.nev}}</h1>

<div id="message-log">
    {{#each messages}}
        {{#if (eq kuldoID ../you.felhID)}}
        <div class = 'your-message-box'>
            <div class="message-box-name">Te:</div>
            {{szoveg}}
            <div class="message-box-date">{{kuldesiIdo}}</div>
        </div>
        {{else}}
        <div class = 'his-message-box'>
            <div class="message-box-name">{{../them.nev}}</div>
            {{szoveg}}
            <div class="message-box-date">{{kuldesiIdo}}</div>
        </div>
        {{/if}}
    {{/each}}
</div> 

<div id="send-message">
    <textarea id="textarea" name="textarea" rows="4" cols="100" placeholder="Ird ide az üzenetet..."></textarea><br>
    <button onclick="sendMessage({{them.felhID}})">Küldés</button>
</div>